model Customer {
  id           Int         @id @default(autoincrement())
  code         String      @unique
  name         String
  credit_limit Decimal     @db.Decimal(14, 2)
  orders       SaleOrder[]
}

/// status: O = open, A = approved, P = posted, C = cancelled
model SaleOrder {
  id          Int             @id @default(autoincrement())
  doc_no      String          @unique
  doc_date    DateTime        @db.Date
  branch_code String
  customer_id Int?
  customer    Customer?       @relation(fields: [customer_id], references: [id])
  status      String          @default("O")
  remark      String?
  sub_total   Decimal         @db.Decimal(14, 2)
  vat_amount  Decimal         @db.Decimal(14, 2)
  net_amount  Decimal         @db.Decimal(14, 2)
  cancel_by   String?
  create_by   String
  update_by   String?
  update_date DateTime        @default(now())
  lines       SaleOrderLine[]
}

model SaleOrderLine {
  id         Int       @id @default(autoincrement())
  order_id   Int
  order      SaleOrder @relation(fields: [order_id], references: [id])
  line_no    Int
  item_code  String
  qty        Decimal   @db.Decimal(14, 3)
  unit_price Decimal   @db.Decimal(14, 2)
  amount     Decimal   @db.Decimal(14, 2)

  @@unique([order_id, line_no])
}

model DocRunning {
  id          Int    @id @default(autoincrement())
  doc_type    String
  branch_code String
  period      String // YYYYMM
  last_no     Int

  @@unique([doc_type, branch_code, period])
}

model PeriodLock {
  id          Int     @id @default(autoincrement())
  branch_code String
  period      String // YYYYMM
  is_locked   Boolean @default(false)

  @@unique([branch_code, period])
}
